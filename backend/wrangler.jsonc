{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "thauma-gifts",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://millarionprojects.github.io",
    "GIFT_TTL_DAYS": "30"
  },
  "r2_buckets": [
    {
      "binding": "GIFTS",
      "bucket_name": "thauma-gifts"
    }
  ],
  "ratelimits": [
    {
      "name": "GIFTS_UPLOAD_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": false
  }
}
